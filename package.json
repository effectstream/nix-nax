{
  "name": "nixnax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nix-Nax: an advanced Midnight teaching example with the complete game UI, a cooperating-player Compact contract, and browser wallet/chain integration.",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.23.2",
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "compact": "compact compile +0.31.1 src/contract/NixNaxArena.compact src/contract/managed/ && compact compile +0.31.1 src/contract/NixNaxArenaStub.compact src/contract/managed-stub/",
    "compact:advanced": "compact compile +0.31.1 advanced/contract/NixNaxArena.compact advanced/contract/managed/ && compact compile +0.31.1 advanced/contract/NixNaxArenaStub.compact advanced/contract/managed-stub/",
    "stack:up": "docker compose -f deploy/docker/network-compose.yml --env-file deploy/docker/network.env up -d",
    "stack:down": "docker compose -f deploy/docker/network-compose.yml down -v",
    "deploy": "bun run scripts/deploy.ts",
    "faucet": "bun run scripts/faucet.ts",
    "deploy:net": "bun run scripts/deploy-network.ts",
    "upgrade:arena": "bun run scripts/upgrade-arena.ts",
    "keys:verify": "bun run scripts/verify-keys.ts",
    "keys:verify:advanced": "bun run advanced/scripts/verify-keys.ts",
    "test": "vitest run test/contract.sim.test.ts test/crypto.test.ts",
    "test:advanced": "vitest run --config advanced/vitest.config.ts advanced/test/contract.sim.test.ts advanced/test/crypto.test.ts",
    "test:webapp": "npm --prefix webapp run test",
    "test:e2e": "vitest run test/e2e --testTimeout=900000 --no-file-parallelism --pool=forks --poolOptions.forks.singleFork",
    "test:e2e:advanced": "vitest run --config advanced/vitest.config.ts advanced/test/e2e/protocol-repair.test.ts --testTimeout=900000 --no-file-parallelism --pool=forks --poolOptions.forks.singleFork",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:advanced": "tsc -p advanced/tsconfig.json --noEmit",
    "typecheck:webapp": "npm --prefix webapp run typecheck",
    "build:webapp": "npm --prefix webapp run build",
    "check": "npm test && npm run test:webapp && npm run typecheck && npm run typecheck:webapp && npm run build:webapp"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "@midnight-ntwrk/wallet-sdk-capabilities": "3.3.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.2.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.1.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.3",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.1.0",
    "@scure/bip39": "^1.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite-plugin-node-polyfills": "0.24.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "qs": "6.16.0"
  }
}
