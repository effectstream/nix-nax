{
  "name": "tictactoe-compact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tic-tac-toe state channel on Midnight: off-chain play, on-chain settlement with equivocation fraud proofs and timeout forfeit.",
  "scripts": {
    "compact": "compact compile +0.30.0 src/contract/TicTacToeChannel.compact src/contract/managed/",
    "compact:check": "node compile.mjs src/contract/TicTacToeChannel.compact",
    "stack:up": "bun run scripts/stack-up.ts",
    "stack:down": "bun run scripts/stack-down.ts",
    "test": "vitest run test/contract.sim.test.ts test/crypto.test.ts",
    "test:e2e": "vitest run test/e2e --testTimeout=600000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "bun run src/cli/ttt.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-types": "4.0.2",
    "@midnight-ntwrk/midnight-js-utils": "4.0.2",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.2",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-capabilities": "3.2.0",
    "@scure/bip39": "^1.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@effectstream/npm-midnight-node": "^0.100.18",
    "@effectstream/npm-midnight-indexer": "^0.100.18",
    "@effectstream/npm-midnight-proof-server": "^0.100.18",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wait-on": "8.0.3"
  }
}
