# Nix-Nax — nginx site config (Linux server, static webapp + relay behind TLS).
#
# Assumes the repo is checked out at /srv/nixnax and built there:
#   bun install && bun run compact
#   cd webapp && bun install && bun run build          # reads the root .env
#   → static site in /srv/nixnax/webapp/dist
#   → ZK assets (~77 MB, prover keys/zkir) in /srv/nixnax/src/contract/managed
#
# The webapp fetches the ZK assets from /contract/compiled/nixnax-arena/* and
# opens a same-origin WebSocket at /relay — in dev both are served by vite
# middleware/proxy, so in production nginx has to provide them (below).
#
# Adjust server_name + certificate paths (e.g. certbot --nginx).

server {
    listen 80;
    server_name nixnax.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name nixnax.example.com;

    ssl_certificate     /etc/letsencrypt/live/nixnax.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nixnax.example.com/privkey.pem;

    root /srv/nixnax/webapp/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm;

    # SPA — everything unknown falls back to index.html.
    location / {
        try_files $uri /index.html;
    }

    # Hashed build assets — cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Compiled contract assets (prover keys / zkir / verifier keys). Immutable
    # for a given contract build; re-deploying a new contract build busts
    # nothing here, so purge or version the path if the circuits change.
    location /contract/compiled/nixnax-arena/ {
        alias /srv/nixnax/src/contract/managed/;
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Off-chain message relay (bun service on 127.0.0.1:4310, see
    # deploy/nixnax-relay.service). WebSocket upgrade + long-lived connections.
    location /relay {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Relay liveness (also handy for external monitoring).
    location /api/health {
        proxy_pass http://127.0.0.1:4310;
    }
}
