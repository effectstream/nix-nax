// TicTacToeChannel.compact
// Two-player tic-tac-toe state channel for Midnight.
//
// Play moves OFF-CHAIN; settle / dispute ON-CHAIN. Cooperative play takes
// exactly one `settle` transaction. Disputes:
//   * silent opponent -> startTimeout + claimTimeout (forfeit)
//   * equivocating opponent -> proveEquivocationBy{X,O} (instant slash)
//
// AUTHENTICATION (read this once):
//
//   `ownPublicKey()` is NOT a trustworthy caller identity (OpenZeppelin
//   audit C-01 / compact-contracts #435). We instead authenticate a caller
//   by PROOF OF KNOWLEDGE of a registered secret: at open, each player
//   publishes idP = persistentHash("ttt:id:", skP); to act as that player
//   on-chain, the caller supplies skP as a witness and the circuit
//   recomputes the hash and checks it equals the registered commitment.
//   This is the audit's recommended fix and matches the `bboard` pattern.
//
//   `settle` and `proveEquivocation*` are PERMISSIONLESS — they carry their
//   own authenticators in the payload (one-time tokens). `claimTimeout` and
//   `claimResult` are outcome-determined by on-chain state, so any caller
//   may trigger them.
//
// MERGE OVERRIDE INVARIANT:
//
//   `settle` can be called multiple times while status == inProgress, but
//   each call must STRICTLY EXTEND the prior committed history (committed
//   moves are repeated). Cells are never cleared: an override that
//   contradicts a prior placement fails the `!board.member(c)` assert
//   naturally. This implements "longer valid history wins" without needing
//   an explicit prefix check in-circuit.

pragma language_version >= 0.16.0;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

// `halfOpen` is the initial state: only X's commitments are on chain. The
// channel is dormant — no settle, no timeout, no fraud proof — until O
// submits their own commitments via `joinChannel`.
export enum Status { halfOpen, inProgress, settled }
export enum Winner { none, x, o, draw }

// Board marks: 0 = empty, 1 = X (first player), 2 = O (second player).

struct TokenPreimage {
  domainSep: Bytes<32>,
  turn: Uint<8>,
  cell: Uint<8>,
  secret: Bytes<32>,
}

// ---------------------------------------------------------------------------
// On-chain (public) state
// ---------------------------------------------------------------------------

// Identity commitments = persistentHash("ttt:id:", playerSecret). NOT pubkeys.
export ledger idX: Bytes<32>;                          // player X (mark 1, moves first)
export ledger idO: Bytes<32>;                          // player O (mark 2)

// Per-player one-time-token Merkle roots (see TokenPreimage).
export ledger rootX: MerkleTreeDigest;
export ledger rootO: MerkleTreeDigest;

export ledger board: Map<Uint<8>, Uint<8>>;            // cell(0..8) -> mark(1|2)
export ledger turnMark: Uint<8>;                       // whose turn: 1 or 2 (for timeout)
export ledger committedTurns: Uint<8>;                 // # moves settled on-chain

export ledger status: Status;
export ledger winner: Winner;

// Timeout clock (absolute block time). Armed by the waiting player.
export ledger deadline: Uint<64>;
export ledger hasDeadline: Boolean;

// Challenge window (absolute block time). Armed by settle; cleared by
// claimResult or by fraud proofs. Allows a longer valid history to override.
export ledger challengeUntil: Uint<64>;
export ledger hasChallenge: Boolean;

// ---------------------------------------------------------------------------
// Caller authentication (proof of knowledge of a registered secret)
// ---------------------------------------------------------------------------

// The caller's player secret, supplied privately at call time.
witness localSecret(): Bytes<32>;

circuit playerId(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "ttt:id:"), secret]);
}

// Returns the caller's mark (1 = X, 2 = O), PROVING they know the matching
// player's secret. This is the trust anchor; it cannot be spoofed.
circuit callerMark(): Uint<8> {
  const h = playerId(localSecret());
  const isX = h == idX;
  const isO = h == idO;
  assert(isX || isO, "caller must prove knowledge of a registered player secret");
  return isX ? 1 : 2;
}

// ---------------------------------------------------------------------------
// Construction (openChannel)
// ---------------------------------------------------------------------------

// Two-phase open:
//   * The deployer (X) submits ONLY X's commitments at construction.
//     Status starts at `halfOpen`. Nothing else can be called yet.
//   * O later submits THEIR OWN commitments via `joinChannel`. That tx
//     populates idO/rootO from the joiner's own browser, so X cannot
//     substitute fake credentials on O's behalf.
//
// Front-running mitigation: if a malicious X calls joinChannel themselves
// with fake credentials, O's later joinChannel call will revert ("channel
// already open"). The failed tx is the explicit signal to O that the
// contract was tampered with — they walk away with nothing lost.
constructor(cX: Bytes<32>, rX: MerkleTreeDigest) {
  idX = disclose(cX);
  rootX = disclose(rX);
  // idO/rootO take their default (zero) until joinChannel populates them.
  turnMark = 1;
  committedTurns = 0;
  status = Status.halfOpen;
  winner = Winner.none;
  hasDeadline = false;
  hasChallenge = false;
}

// Phase 2 of open. The joiner submits their own identity commitment and
// token-tree root. Permissionless from the contract's view — the security
// comes from the joiner being the one with the credentials in their browser
// (the relay just forwards their HTTP call).
export circuit joinChannel(cO: Bytes<32>, rO: MerkleTreeDigest): [] {
  assert(status == Status.halfOpen, "channel already open");
  idO = disclose(cO);
  rootO = disclose(rO);
  status = Status.inProgress;
}

// ---------------------------------------------------------------------------
// Token scheme (per-(turn, cell) one-time tokens)
// ---------------------------------------------------------------------------

// leaf = persistentHash(domainSep, turn, cell, secret).
circuit tokenLeaf(turn: Uint<8>, cell: Uint<8>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<TokenPreimage>(
    TokenPreimage { domainSep: pad(32, "ttt:otk:"), turn: turn, cell: cell, secret: secret }
  );
}

// Verifies that (turn, cell, secret) is a token committed under `root`.
circuit tokenIsUnder(
  root: MerkleTreeDigest,
  turn: Uint<8>,
  cell: Uint<8>,
  secret: Bytes<32>,
  path: MerkleTreePath<10, Bytes<32>>
): Boolean {
  const leaf = tokenLeaf(turn, cell, secret);
  return path.leaf == leaf
      && merkleTreePathRoot<10, Bytes<32>>(path).field == root.field;
}

// ---------------------------------------------------------------------------
// Board helpers
// ---------------------------------------------------------------------------

circuit cellAt(c: Uint<8>): Uint<8> {
  if (!board.member(c)) { return 0; }
  return board.lookup(c);
}

circuit lineWins(a: Uint<8>, b: Uint<8>, c: Uint<8>, p: Uint<8>): Boolean {
  return cellAt(a) == p && cellAt(b) == p && cellAt(c) == p;
}

circuit hasWon(p: Uint<8>): Boolean {
  return lineWins(0, 1, 2, p) || lineWins(3, 4, 5, p) || lineWins(6, 7, 8, p)
      || lineWins(0, 3, 6, p) || lineWins(1, 4, 7, p) || lineWins(2, 5, 8, p)
      || lineWins(0, 4, 8, p) || lineWins(2, 4, 6, p);
}

// ---------------------------------------------------------------------------
// Happy path: settle the whole off-chain history in one transaction
// ---------------------------------------------------------------------------

// Replay `nMoves` authenticated moves (token per move) onto the board, then
// record result. Caller-supplied `untilTime` arms a challenge window during
// which a longer valid history may override.
export circuit settle(
  nMoves: Uint<8>,
  cells:   Vector<9, Uint<8>>,
  secrets: Vector<9, Bytes<32>>,
  paths:   Vector<9, MerkleTreePath<10, Bytes<32>>>,
  untilTime: Uint<64>
): [] {
  assert(status == Status.inProgress, "already settled");
  const n = disclose(nMoves);
  assert(n <= 9, "too many moves");
  assert(n > committedTurns, "must strictly extend the committed history");

  // We skip indices already settled on-chain (the board carries those
  // placements from the prior settle call). For the NEW indices we verify
  // the one-time token and place the mark. The win check after the loop
  // runs on the combined board state, so a previously-committed prefix
  // still contributes to wins/draws.
  //
  // Why skipping is safe: only the player who actually revealed token
  // (turn, cell) can produce a valid path under their root (the secrets
  // are otherwise unknown). So any "longer" history must use real, revealed
  // tokens for each new turn — the cheater cannot fabricate X's future moves.
  for (const i of 0..9) {
    if (i >= committedTurns && i < n) {
      // Static loop: at compile time `i` is a literal 0..8, so this
      // enumeration is fully resolved per iteration.
      const isXTurn = (i == 0) || (i == 2) || (i == 4) || (i == 6) || (i == 8);
      const mark = isXTurn ? 1 as Uint<8> : 2 as Uint<8>;
      const c = disclose(cells[i]);
      assert(c < 9, "cell out of range");
      assert(!board.member(c), "cell already taken");
      const root = isXTurn ? rootX : rootO;
      assert(
        tokenIsUnder(root, i as Uint<8>, c, disclose(secrets[i]), disclose(paths[i])),
        "invalid one-time token for this (turn, cell)"
      );
      board.insert(c, mark);
    }
  }

  committedTurns = n;
  if (hasWon(1)) {
    winner = Winner.x;
  } else if (hasWon(2)) {
    winner = Winner.o;
  } else if (n == 9) {
    winner = Winner.draw;
  } else {
    winner = Winner.none;
    // Whose turn next? Even n -> X (mark 1), odd n -> O (mark 2).
    const nextIsX = (n == 0) || (n == 2) || (n == 4) || (n == 6) || (n == 8);
    turnMark = nextIsX ? 1 as Uint<8> : 2 as Uint<8>;
  }

  challengeUntil = disclose(untilTime);
  hasChallenge = true;
  hasDeadline = false;
}

// Finalise after the challenge window expires. Permissionless.
export circuit claimResult(): [] {
  assert(status == Status.inProgress, "already settled");
  assert(hasChallenge, "no settlement to finalise");
  assert(blockTimeGte(challengeUntil), "challenge window still open");
  status = Status.settled;
  hasChallenge = false;
}

// ---------------------------------------------------------------------------
// Liveness: timeout / forfeit (handles "opponent goes silent")
// ---------------------------------------------------------------------------

// The waiting player (who proves their secret) arms a clock; if the player
// whose turn it is doesn't act by `untilTime`, they can be timed out.
export circuit startTimeout(untilTime: Uint<64>): [] {
  assert(status == Status.inProgress, "game is not in progress");
  const mark = callerMark();
  assert(mark != turnMark, "only the waiting player can start the timeout");
  assert(blockTimeLt(disclose(untilTime)), "deadline must be in the future");
  deadline = disclose(untilTime);
  hasDeadline = true;
}

// After the armed deadline passes with no move, the player to move forfeits.
// Permissionless: outcome is determined by on-chain state.
export circuit claimTimeout(): [] {
  assert(status == Status.inProgress, "game is not in progress");
  assert(hasDeadline, "no timeout has been armed");
  assert(blockTimeGte(deadline), "deadline has not been reached yet");
  winner = (turnMark == 1) ? Winner.o : Winner.x;   // the staller loses
  status = Status.settled;
  hasDeadline = false;
  hasChallenge = false;
}

// ---------------------------------------------------------------------------
// Anti-cheat: equivocation fraud proofs
// ---------------------------------------------------------------------------

// Anyone holding two of player X's tokens for the SAME turn but DIFFERENT
// cells can prove X equivocated -> O wins instantly. Permissionless.
export circuit proveEquivocationByX(
  turn: Uint<8>,
  cellA: Uint<8>, secretA: Bytes<32>, pathA: MerkleTreePath<10, Bytes<32>>,
  cellB: Uint<8>, secretB: Bytes<32>, pathB: MerkleTreePath<10, Bytes<32>>
): [] {
  assert(status == Status.inProgress, "already settled");
  assert(disclose(cellA) != disclose(cellB), "not a fork: same cell");
  assert(tokenIsUnder(rootX, disclose(turn), disclose(cellA), disclose(secretA), disclose(pathA)),
         "token A is not a valid X token");
  assert(tokenIsUnder(rootX, disclose(turn), disclose(cellB), disclose(secretB), disclose(pathB)),
         "token B is not a valid X token");
  winner = Winner.o;
  status = Status.settled;
  hasDeadline = false;
  hasChallenge = false;
}

// Symmetric proof against O.
export circuit proveEquivocationByO(
  turn: Uint<8>,
  cellA: Uint<8>, secretA: Bytes<32>, pathA: MerkleTreePath<10, Bytes<32>>,
  cellB: Uint<8>, secretB: Bytes<32>, pathB: MerkleTreePath<10, Bytes<32>>
): [] {
  assert(status == Status.inProgress, "already settled");
  assert(disclose(cellA) != disclose(cellB), "not a fork: same cell");
  assert(tokenIsUnder(rootO, disclose(turn), disclose(cellA), disclose(secretA), disclose(pathA)),
         "token A is not a valid O token");
  assert(tokenIsUnder(rootO, disclose(turn), disclose(cellB), disclose(secretB), disclose(pathB)),
         "token B is not a valid O token");
  winner = Winner.x;
  status = Status.settled;
  hasDeadline = false;
  hasChallenge = false;
}
