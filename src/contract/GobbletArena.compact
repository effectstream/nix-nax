  assert(d.status == Status.inProgress, "already settled");
  const keys = gameKeys.lookup(gid);
  assert(disclose(a0) != disclose(b0) || disclose(a1) != disclose(b1)
      || disclose(a2) != disclose(b2) || disclose(a3) != disclose(b3)
      || disclose(randomA) != disclose(randomB),
         "not a fork: same random leaf");
  assert(randomIsUnder(keys.rootRndO, gid, disclose(turn), disclose(slot), disclose(a0), disclose(a1), disclose(a2), disclose(a3), disclose(randomA), disclose(pathA)),
         "random A is not a valid O random leaf");
  assert(randomIsUnder(keys.rootRndO, gid, disclose(turn), disclose(slot), disclose(b0), disclose(b1), disclose(b2), disclose(b3), disclose(randomB), disclose(pathB)),
         "random B is not a valid O random leaf");
  gameState.insert(gid, dynSettled(d, Winner.x));
