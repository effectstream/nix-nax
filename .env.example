# Nix-Nax — shared environment file (copy to .env; .env is gitignored).
#
# One file drives both sides:
#   * MIDNIGHT_*  — read by the Node scripts (deploy / stack / tests) at runtime.
#     Bun auto-loads .env from the repo root.
#   * VITE_*      — baked into the webapp bundle by `vite build` (vite.config.ts
#     sets envDir to the repo root). NOT secrets — they ship in the JS bundle.
#     Changing them requires a rebuild.
#
# With everything commented out, both sides default to the local `undeployed`
# dev stack (bun run stack:up).

# ── Secrets (server-side only — never VITE_-prefixed) ────────────────────────
# Funds the deploy script's wallet. The all-zeros…01 default only exists on the
# local dev chain; for preview/preprod/mainnet use a real funded seed.
#MIDNIGHT_WALLET_SEED=

# ── Node-side network endpoints (scripts/deploy.ts, e2e tests) ───────────────
#MIDNIGHT_NETWORK_ID=undeployed
#MIDNIGHT_NODE_URL=http://127.0.0.1:9944
#MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
#MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
#MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
#MIDNIGHT_STORAGE_PASSWORD=
#MIDNIGHT_DEPLOYMENT_FILE=

# ── Relay service ────────────────────────────────────────────────────────────
#RELAY_PORT=4310

# ── Webapp: which network this BUILD targets ─────────────────────────────────
# Selects the *_<NETWORK> row below. One value per build; rebuild to switch.
#VITE_NETWORK_ID=preview

# ── Webapp: arena contract address, one per network ──────────────────────────
# Deploy the contract on each network (bun run deploy against that network's
# endpoints) and record the addresses here; VITE_NETWORK_ID picks the row.
# On `undeployed` the app falls back to webapp/public/arena.json if unset.
#VITE_ARENA_ADDRESS_PREVIEW=
#VITE_ARENA_ADDRESS_PREPROD=
#VITE_ARENA_ADDRESS_MAINNET=
#VITE_ARENA_ADDRESS_UNDEPLOYED=
# Generic fallback used when no suffixed row matches:
#VITE_ARENA_ADDRESS=

# ── Webapp: chain endpoints, one set per network ─────────────────────────────
# Must be https/wss when the site is served over TLS (mixed-content rule).
# A network-suffixed value wins over the generic one; unset + undeployed
# falls back to the localhost dev stack.
#VITE_INDEXER_URL_PREVIEW=
#VITE_INDEXER_WS_URL_PREVIEW=
#VITE_NODE_URL_PREVIEW=
#VITE_PROOF_SERVER_URL_PREVIEW=

#VITE_INDEXER_URL_PREPROD=
#VITE_INDEXER_WS_URL_PREPROD=
#VITE_NODE_URL_PREPROD=
#VITE_PROOF_SERVER_URL_PREPROD=

#VITE_INDEXER_URL_MAINNET=
#VITE_INDEXER_WS_URL_MAINNET=
#VITE_NODE_URL_MAINNET=
#VITE_PROOF_SERVER_URL_MAINNET=

# Generic (used when no suffixed value exists for VITE_NETWORK_ID):
#VITE_INDEXER_URL=
#VITE_INDEXER_WS_URL=
#VITE_NODE_URL=
#VITE_PROOF_SERVER_URL=

# Encrypts the per-browser private-state store (not a server secret).
#VITE_STORAGE_PASSWORD=
