# Nix-Nax — shared environment file (copy to .env; .env is gitignored).
#
# One file drives both sides:
#   * MIDNIGHT_*  — read by the Node scripts (deploy / stack / tests) at runtime.
#     Bun auto-loads .env from the repo root.
#   * VITE_*      — baked into the webapp bundle by `vite build` (vite.config.ts
#     sets envDir to the repo root). NOT secrets — they ship in the JS bundle.
#     Changing them requires a rebuild.
#
# This template is preconfigured for the LIVE PREVIEW deployment: copy it and
# you're pointed at the arena already deployed on Midnight's preview network —
#   cp .env.example .env
# You still need a proof server reachable at VITE_PROOF_SERVER_URL_PREVIEW
# (defaults to a local one at :6300 — `bun run stack:up`) and a browser wallet
# set to preview. To run the fully local dev chain instead, set
# VITE_NETWORK_ID=undeployed (or just delete .env — with no .env both sides
# default to the local `undeployed` stack).

# ── Secrets (server-side only — never VITE_-prefixed) ────────────────────────
# Funds the deploy script's wallet. The all-zeros…01 default only exists on the
# local dev chain; for preview/preprod/mainnet use a real funded seed.
#MIDNIGHT_WALLET_SEED=

# ── Node-side network endpoints (scripts/deploy.ts, e2e tests) ───────────────
#MIDNIGHT_NETWORK_ID=undeployed
#MIDNIGHT_NODE_URL=http://127.0.0.1:9944
#MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
#MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
#MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
#MIDNIGHT_STORAGE_PASSWORD=
#MIDNIGHT_DEPLOYMENT_FILE=

# ── Multi-network deploy (scripts/deploy-network.ts — `bun run deploy:net`) ──
# Deploys to a chosen network and writes VITE_ARENA_ADDRESS_<NET> (+ endpoints)
# below. MN_ENV picks the network; MN_MNEMONIC or MN_SEED funds the deploy
# (a funded, DUST-registered wallet for hosted networks). The shell takes
# precedence over these. Proof server is always LOCAL for deploy (:6300).
#MN_ENV=preview
#MN_MNEMONIC=
#MN_SEED=
# Endpoint overrides (else the network's defaults, /api/v3/graphql path):
#MN_INDEXER_URL=
#MN_INDEXER_WS_URL=
#MN_NODE_URL=
#MN_PROOF_SERVER_URL=http://127.0.0.1:6300

# ── Relay service ────────────────────────────────────────────────────────────
#RELAY_PORT=4310

# ── Webapp: which network this BUILD targets ─────────────────────────────────
# Selects the *_<NETWORK> row below. One value per build; rebuild to switch.
VITE_NETWORK_ID=preview

# ── Webapp: arena contract address, one per network ──────────────────────────
# `bun run deploy:net` deploys on a network and fills the matching row here;
# VITE_NETWORK_ID picks which row a build uses. On `undeployed` the app falls
# back to webapp/public/arena.json if unset.
# Live preview deployment (official example — all 16 circuits installed):
VITE_ARENA_ADDRESS_PREVIEW=de4bbeb807f25dbc8532ef382e51ab8fed4effbf683aca11547185a72dcd79df
#VITE_ARENA_ADDRESS_PREPROD=
#VITE_ARENA_ADDRESS_MAINNET=
#VITE_ARENA_ADDRESS_UNDEPLOYED=
# Generic fallback used when no suffixed row matches:
#VITE_ARENA_ADDRESS=

# ── Webapp: chain endpoints, one set per network ─────────────────────────────
# Must be https/wss when the site is served over TLS (mixed-content rule).
# A network-suffixed value wins over the generic one; unset + undeployed
# falls back to the localhost dev stack.
VITE_INDEXER_URL_PREVIEW=https://indexer.preview.midnight.network/api/v3/graphql
VITE_INDEXER_WS_URL_PREVIEW=wss://indexer.preview.midnight.network/api/v3/graphql/ws
VITE_NODE_URL_PREVIEW=https://rpc.preview.midnight.network
# Proof server the BROWSER uses. Local dev: `bun run stack:up` gives one at :6300.
# For a public deployment, point this at a proof server reachable by players.
VITE_PROOF_SERVER_URL_PREVIEW=http://127.0.0.1:6300

#VITE_INDEXER_URL_PREPROD=
#VITE_INDEXER_WS_URL_PREPROD=
#VITE_NODE_URL_PREPROD=
#VITE_PROOF_SERVER_URL_PREPROD=

#VITE_INDEXER_URL_MAINNET=
#VITE_INDEXER_WS_URL_MAINNET=
#VITE_NODE_URL_MAINNET=
#VITE_PROOF_SERVER_URL_MAINNET=

# Generic (used when no suffixed value exists for VITE_NETWORK_ID):
#VITE_INDEXER_URL=
#VITE_INDEXER_WS_URL=
#VITE_NODE_URL=
#VITE_PROOF_SERVER_URL=

# Encrypts the per-browser private-state store (not a server secret).
#VITE_STORAGE_PASSWORD=
